{% extends 'views/base.html.twig' %}

{% block contentTitle %}
    <title>Agenda</title>
{% endblock %}

{% block contentStyle %}
    <link rel="stylesheet" href="assets/admin.css">
{% endblock %}

{% block contentMain %}
    {# Get current Monday #}
    {% set lastMonday = nextMonday | date_modify('-7 day') | date('Y-m-d') %}

    <!-- HEADER -->
    {% include "views/blocks/header.html.twig" with {
        'title' : 'Voici votre agenda!',
        'content' : "Gérez votre emploi du temps à partir de ce calendrier."
    } %}
    <!-- CONTENT LIST -->
    <article>
        <section class="is-container has-agenda">
            <p class="is-filter-title has-very-medium-font has-no-margin">Filtres d'affichage</p>
            <a class="is-filter-button" id="display-all" href="#display-all">Tout afficher</a>
            <a class="is-filter-button" id="display-appointments" href="#display-appointments">Afficher les rendez-vous</a>
            <a class="is-filter-button" id="display-offs" href="#display-offs">Afficher les absences</a>
            <a class="is-filter-button" id="display-available" href="#display-available">Afficher les créneaux disponibles</a>
            <hr class="is-separator has-no-margin-left has-big-margin-top has-left-small-margin">
            <form class="is-agenda-form" method="post">
                <div class="is-agenda-container">

                    {% for dayName, list in event %}
                        {% if list['mask'] is same as false %}
                            {% set identifier = list.startDate | format_datetime(locale: 'fr', pattern: 'cc')%}
                            <div class="is-agenda-row has-text-left {{ list.class }}">
                                <p class="is-agenda-row-title">{{ list.startDate | format_datetime(locale: 'fr', pattern: 'cccc d MMMM Y') | upper }}</p>
                                <input class="is-radio-select has-no-display" id="agenda_{{ identifier }}_1" name="agenda_{{ identifier }}" type="radio" value="{{ list.startDate | format_datetime(pattern: 'Y-MM-d') }}_08:00-19:30" />
                                <input class="is-radio-no-select has-no-display" id="agenda_{{ identifier }}_2" name="agenda_{{ identifier }}" type="radio" value="2" />
                                <label for="agenda_{{ identifier }}_1" class="is-agenda-row-button is-agenda-select">Sélectionner ce jour</label>
                                <label for="agenda_{{ identifier }}_2" class="is-agenda-row-button is-agenda-no-select">Déselectionner ce jour</label>
                                <div class="is-agenda-card-list">
                                    {% for data in list.data %}
                                        {% if data.type == 'available' or data.type == 'off' %}
                                            <input class="has-no-display" id="{{ data.id }}" type="checkbox" name="agenda_{{ data.id }}" value="{{ list.startDate ~ '_' ~ data.period }}"/>
                                            <label class="is-agenda-card{{ data.type == 'off' ? ' has-day-off' }}" for="{{ data.id }}">
                                                <span class="is-agenda-card-label">
                                                    <span class="is-agenda-title">{{ data.period }}</span>
                                                </span>
                                            </label>
                                        {% endif %}
                                        {% if data.type == 'appointment' %}
                                            <div class="is-agenda-card has-appointment">
                                                <span class="is-agenda-card-label">
                                                    <span class="is-agenda-title">{{ data.period }}</span>
                                                </span>
                                                <ul class="is-agenda-data-list">
                                                    <li>{{ data.lastName | upper }}</li>
                                                    <li>{{ data.firstName }}</li>
                                                    <li>{{ data.address }}</li>
                                                    <li>{{ data.phoneNumber }}</li>
                                                </ul>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}

                    <div class="has-width-100 has-text-left">
                        {% if lastMonday >= 'now' | date('Y-m-d')  %}
                            <a class="is-button has-right-very-medium-margin" href="?date={{ lastMonday | date_modify('-7 day') | date('Y-m-d') }}">Semaine précedente</a>
                        {% endif %}
                        <a class="is-button" href="?date={{ nextMonday }}">Semaine suivante</a>
                    </div>

                </div>

                <div class="has-width-100 has-big-margin-top has-text-right has-left-very-medium-margin">
                    <input class="is-button" type="submit" name="submit_agenda_add" value="Valider les absences" />
                    <input class="is-button has-left-very-medium-margin" type="submit" name="submit_agenda_delete" value="Annuler les absences" />
                </div>
            </form>
        </section>
    </article>
{% endblock %}