{% extends 'views/base.html.twig' %}

{% block contentTitle %}
    <title>Demandes</title>
{% endblock %}

{% block contentStyle %}
    <link rel="stylesheet" href="assets/admin.css">
{% endblock %}

{% block contentMain %}

    <!-- HEADER -->
    {% include "views/blocks/header.html.twig" with {
        'title' : 'Voici vos demandes de rendez-vous!',
        'content' : "Gérez vos rendez-vous, acceptez ou refusez vos demandes."
    } %}

    <!-- CONTENT LIST -->
    <article>
        <section class="is-container">
            {% if appointments | length > 0 %}
                <form method="post">
                    {% for appointment in appointments %}
                        {% set appointmentTitle = appointment['lastName'] ~ ' ' ~ appointment['firstName'] | upper ~ ' ' ~ appointment['address'] ~ '<br>' ~ appointment['dateTime'] | format_datetime(locale: 'fr', pattern: 'cccc d MMMM Y') ~ ' ' ~ appointment['datePeriod'] ~ '<br>' ~ appointment['phoneNumber'] ~ '<br>' ~ appointment['email'] %}
                        {% set appointmentStatus = appointment['appointmentStatus'] %}
                        <div class="is-request has-flex has-width-100">
                            <p class="is-request-content has-very-medium-font">{{ appointmentTitle | raw }}</p>
                            <div class="is-request-actions has-text-right">
                                {% if appointment['appointmentStatus'] == 'pending' %}
                                    <input class="is-button has-accepted has-no-background" type="submit" name="submit_request_accept-{{ appointment['appointmentID'] }}" value="Accepter" />
                                    <input class="is-button has-rejected has-no-background" type="submit" name="submit_request_reject-{{ appointment['appointmentID'] }}" value="Refuser" />
                                {% endif %}
                                {% if appointmentStatus != 'pending' %}
                                    {% if appointment['appointmentStatus'] == 'accepted' %}
                                        <span class="is-status has-inline-block has-accepted">Validé</span>
                                    {% endif %}
                                    {% if appointment['appointmentStatus'] == 'rejected' %}
                                        <span class="is-status has-inline-block has-rejected">Refusé</span>
                                    {% endif %}
                                    <input class="is-button has-rejected has-no-background" type="submit" name="submit_request_cancel-{{ appointment['appointmentID'] }}" value="Annuler" />
                                    {% if appointment['appointmentStatus'] == 'rejected' %}
                                        <input class="is-button has-deleted has-no-background" type="submit" name="submit_request_delete-{{ appointment['appointmentID'] }}-{{ appointment['dateID'] }}" value="Supprimer" />
                                    {% endif %}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </form>
            {% endif %}
            {% if appointments | length == 0 %}
                <p class="has-very-medium-font">Vous n'avez pas de demandes en attente.</p>
            {% endif %}
        </section>
    </article>
{% endblock %}