{% if messageDatabaseConnectionError is not empty %}
    <details id="has-error" class="is-notification has-error-notification" open>
        <p>{{ "La connection à la base de donnée a échoué:" ~ messageDatabaseConnectionError }}</p>
        <summary>✖</summary>
    </details>
{% endif %}
{% if messageNotification is not empty %}
    <details id="has-success" class="is-notification has-success" open>
        <p>{{ messageNotification }}</p>
        <summary>✖</summary>
    </details>
{% endif %}
{% if messageMailSuccess is not empty %}
    <details id="has-success" class="is-notification has-success" open>
        <p>{{ messageMailSuccess | raw }}</p>
        <summary>✖</summary>
    </details>
{% endif %}
{% if messageMailError is not empty %}
    <details id="has-success" class="is-notification has-error-notification" open>
        <p>{{ messageMailError | raw }}</p>
        <summary>✖</summary>
    </details>
{% endif %}
<header class="is-block-title">
    <div class="is-block-connection has-flex {{ returnLink is empty ? 'has-justify-end' : 'has-justify-between' }}">
        {% if returnLink is not empty %}
            <a class="is-link has-very-medium-font" href="{{ returnLink }}"><span class="has-arrow has-arrow-left"> Retour à la page précédente</span></a>
        {% endif %}
        {% if session["joe_logged"] is same as(true) %}
            <a class="is-link has-very-medium-font" href="/logout"><span class="has-arrow has-arrow-right"> Se déconnecter</span></a>
        {% endif %}
    </div>
    <div class="is-container has-text-center">
        <h1 class="is-title-very-large has-very-medium-margin">{{ title }}</h1>
        <p class="is-content has-very-medium-margin">{{ content | raw }}</p>
    </div>
</header>
<hr class="is-separator has-big-margin-top"/>