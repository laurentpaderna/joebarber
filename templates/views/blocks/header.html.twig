{% if databaseConnectionError is not empty %}
    <p class="is-error-notification">{{ "La connection à la base de donnée a échoué:" ~ databaseConnectionError }}</p>
{% endif %}
<header class="is-block-title">
    <div class="is-block-connection {{ returnLink is empty ? 'has-justify-end' : 'has-justify-between' }}">
        {% if returnLink is not empty %}
            <a class="is-link has-very-medium-font" href="{{ returnLink }}"><span class="has-arrow has-arrow-left"> Retour à la page précédente</span></a>
        {% endif %}
        {% if session["joe_logged"] is same as(true) %}
            <a class="is-link has-very-medium-font" href="/logout"><span class="has-arrow has-arrow-right"> Se déconnecter</span></a>
        {% endif %}
    </div>
    <div class="is-container has-text-center">
        <h1 class="is-title-very-large has-no-margin">{{ title }}</h1>
        <p class="is-content has-no-margin">{{ content|raw }}</p>
    </div>
</header>
<hr class="is-separator has-big-margin-top"/>