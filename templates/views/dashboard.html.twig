{% extends 'views/base.html.twig' %}

{% block contentTitle %}
    <title>Tableau de bord</title>
{% endblock %}

{% block contentStyle %}
    <link rel="stylesheet" href="assets/admin.css">
{% endblock %}

{% block contentMain %}
    <!-- HEADER -->
    {#Set appointment message#}
    {% set plural = appointmentAmount > 1 ? 's' : '' %}
    {% set appointmentMessage = appointmentAmount > 0 ? 'Tu as <strong class="has-very-large-font">' ~ appointmentAmount ~ '</strong> demande' ~ plural ~ ' en attente' : "Tu n'as aucune demande en attente" %}
    {#Set date message#}
    {% set dateMessage = dateAmount > 0 ? " et tu as <strong class='has-very-large-font'>" ~ dateAmount ~ "</strong> rendez-vous aujourd'hui." : offAmount > 0 ? " et tu es en congé aujourd'hui." : " et tu n'as aucun rendez-vous aujourd'hui." %}

    {% set message = appointmentMessage %}
    {% include "views/blocks/header.html.twig" with {
        'title' : 'Bonjour Johan!',
        'content' : appointmentMessage ~ dateMessage
    } %}
    <!-- CONTENT LIST -->
    <article>
        <div class="is-container has-flex has-block-dashboard">
            <a class="is-dashboard-link is-dashboard-agenda" href="/agenda?date={{ 'now' | date('Y-m-d') }}">
                    <span class="is-dashboard-content has-width-100">
                        <span class="is-dashboard-text">Mon agenda</span>
                        <span class="is-dashboard-icon">&#9201;</span>
                    </span>
            </a>
            <a class="is-dashboard-link is-dashboard-request" href="/requests">
                    <span class="is-dashboard-content has-width-100">
                        <span class="is-dashboard-text">Mes demandes</span>
                        <span class="is-dashboard-icon">&#9993;</span>
                    </span>
            </a>
        </div>
    </article>
{% endblock %}