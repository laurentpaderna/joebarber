{% extends 'views/base.html.twig' %}

{% block contentTitle %}
    <title>Tableau de bord</title>
{% endblock %}

{% block contentStyle %}
    <link rel="stylesheet" href="assets/admin.css">
{% endblock %}

{% block contentMain %}
    <!-- HEADER -->
    {% include "views/blocks/header.html.twig" with {
        'title' : 'Bonjour Johan!',
        'content' : "Tu as <strong class='has-very-large-font'>3</strong> demandes en attente, et <strong class='has-very-large-font'>1</strong> rendez-vous aujourd'hui."
    } %}
    <!-- CONTENT LIST -->
    <article>
        <div class="is-container has-flex has-block-dashboard">
            <a class="is-dashboard-link is-dashboard-agenda" href="/agenda?date={{ 'now' | date('Y-m-d') }}">
                    <span class="is-dashboard-content has-width-100">
                        <span class="is-dashboard-text">Mon agenda</span>
                        <span class="is-dashboard-icon">&#9201;</span>
                    </span>
            </a>
            <a class="is-dashboard-link is-dashboard-request" href="/requests">
                    <span class="is-dashboard-content has-width-100">
                        <span class="is-dashboard-text">Mes demandes</span>
                        <span class="is-dashboard-icon">&#9993;</span>
                    </span>
            </a>
        </div>
    </article>
{% endblock %}